msgstr "잘못된 페이지네이션 매개변수입니다."

#: invenio_records_rest/views.py:538
#, python-format
msgid "Maximum number of %(count)s results have been reached."
msgstr "최대 결과 수 %(count)s개에 도달했습니다."
