msgid "PID has been deleted."
msgstr "PID ถูกลบแล้ว"

#: invenio_records_rest/errors.py:137
#, python-format
msgid "No object assigned to %(pid)s."
msgstr "ไม่มีออบเจกต์ที่กำหนดให้ %(pid)s"

#: invenio_records_rest/errors.py:150
#, python-format
msgid "Invalid redirect - pid_type %(pid_type)s endpoint missing."
msgstr "การเปลี่ยนเส้นทางไม่ถูกต้อง - ขาด endpoint pid_type %(pid_type)s"

#: invenio_records_rest/errors.py:168
#, python-format
msgid "PID %(pid)s could not be resolved."
msgstr "ไม่สามารถ resolve PID %(pid)s ได้"

#: invenio_records_rest/errors.py:182
#, python-format
msgid "Unsupported media type \"%(content_type)s\"."
msgstr "ประเภทสื่อไม่รองรับ \"%(content_type)s\""

#: invenio_records_rest/errors.py:196
msgid "Could not load data."
msgstr "ไม่สามารถโหลดข้อมูลได้"

#: invenio_records_rest/errors.py:208
msgid "Could not patch JSON."
msgstr "ไม่สามารถ patch JSON ได้"

#: invenio_records_rest/errors.py:221
#, python-format
msgid "Missing %(ctx_field)s context."
msgstr "ขาด context %(ctx_field)s"

#: invenio_records_rest/errors.py:236
#, python-format
msgid "No completions requested.%(options)s"
msgstr "ไม่มีการร้องขอการเติมให้สมบูรณ์%(options)s"

#: invenio_records_rest/errors.py:251
#, python-format
msgid "Validation error: %(error)s."
msgstr "ข้อผิดพลาดการตรวจสอบ: %(error)s"

#: invenio_records_rest/errors.py:265
msgid "An internal server error occurred when handling the request."
msgstr "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์ขณะจัดการคำขอ"

#: invenio_records_rest/views.py:66
