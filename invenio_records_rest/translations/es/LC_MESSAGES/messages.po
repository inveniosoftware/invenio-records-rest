#: invenio_records_rest/config.py:262
msgid "Best match"
msgstr "Mejor coincidencia"

#: invenio_records_rest/config.py:268
msgid "Most recent"
msgstr "Más reciente"

#: invenio_records_rest/errors.py:59
msgid "Invalid query syntax."
msgstr "Sintaxis de consulta no válida."

#: invenio_records_rest/errors.py:75
#, python-format
msgid "Style %(style)s could not be found."
msgstr "No se pudo encontrar el estilo %(style)s."

#: invenio_records_rest/errors.py:101
msgid "PID does not exist."
msgstr "El PID no existe."

#: invenio_records_rest/errors.py:113
msgid "PID is not registered."
msgstr "El PID no está registrado."

#: invenio_records_rest/errors.py:125
msgid "PID has been deleted."
msgstr "El PID ha sido eliminado."

#: invenio_records_rest/errors.py:137
#, python-format
msgid "No object assigned to %(pid)s."
msgstr "No se ha asignado ningún objeto a %(pid)s."

#: invenio_records_rest/errors.py:150
#, python-format
msgid "Invalid redirect - pid_type %(pid_type)s endpoint missing."
msgstr "Redirección %(pid_type)s no válida: falta el punto final pid_type."

#: invenio_records_rest/errors.py:168
#, python-format
msgid "PID %(pid)s could not be resolved."
msgstr "No se pudo resolver el PID %(pid)s."

#: invenio_records_rest/errors.py:182
#, python-format
msgid "Unsupported media type \"%(content_type)s\"."
msgstr "Tipo de medio no compatible \"%(content_type)s\"."

#: invenio_records_rest/errors.py:196
msgid "Could not load data."
msgstr "No se pudieron cargar los datos."

#: invenio_records_rest/errors.py:208
msgid "Could not patch JSON."
msgstr "No se pudo parchear el JSON."

#: invenio_records_rest/errors.py:221
#, python-format
msgid "Missing %(ctx_field)s context."
msgstr "Falta %(ctx_field)s contexto."

#: invenio_records_rest/errors.py:236
#, python-format
msgid "No completions requested.%(options)s"
msgstr "No se solicitan respuestas. %(options)s"

#: invenio_records_rest/errors.py:251
#, python-format
msgid "Validation error: %(error)s."
msgstr "Error de validación: %(error)s."

#: invenio_records_rest/errors.py:265
msgid "An internal server error occurred when handling the request."
msgstr "Se produjo un error interno del servidor al procesar la solicitud."

#: invenio_records_rest/views.py:66
msgid "The syntax of the search query is invalid."
msgstr "La sintaxis de la consulta de búsqueda no es válida."

#: invenio_records_rest/views.py:441
msgid "The query parameters from and page must not be used at the same time."
msgstr ""
"Los parámetros de consulta \"desde\" y \"página\" no deben usarse al mismo "
"tiempo."

#: invenio_records_rest/views.py:501
msgid "Invalid pagination parameters."
msgstr "Parámetros de paginación no válidos."

#: invenio_records_rest/views.py:538
#, python-format
msgid "Maximum number of %(count)s results have been reached."
msgstr "Se ha alcanzado el número máximo de %(count)s resultados."
