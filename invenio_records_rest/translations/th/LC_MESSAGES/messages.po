msgstr "ไวยากรณ์ของคำค้นหาไม่ถูกต้อง"

#: invenio_records_rest/views.py:441
msgid "The query parameters from and page must not be used at the same time."
msgstr "พารามิเตอร์ from และ page ต้องไม่ถูกใช้พร้อมกัน"

#: invenio_records_rest/views.py:501
msgid "Invalid pagination parameters."
msgstr "พารามิเตอร์การแบ่งหน้าไม่ถูกต้อง"

#: invenio_records_rest/views.py:538
#, python-format
msgid "Maximum number of %(count)s results have been reached."
msgstr "ถึงจำนวนผลลัพธ์สูงสุด %(count)s รายการแล้ว"
