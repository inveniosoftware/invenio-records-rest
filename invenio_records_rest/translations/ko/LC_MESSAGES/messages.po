#, python-format
msgid "No object assigned to %(pid)s."
msgstr "%(pid)s에 할당된 객체가 없습니다."

#: invenio_records_rest/errors.py:150
#, python-format
msgid "Invalid redirect - pid_type %(pid_type)s endpoint missing."
msgstr "잘못된 리디렉션 - pid_type %(pid_type)s 엔드포인트가 없습니다."

#: invenio_records_rest/errors.py:168
#, python-format
msgid "PID %(pid)s could not be resolved."
msgstr "PID %(pid)s을(를) 확인할 수 없습니다."

#: invenio_records_rest/errors.py:182
#, python-format
msgid "Unsupported media type \"%(content_type)s\"."
msgstr "지원하지 않는 미디어 유형 \"%(content_type)s\"입니다."

#: invenio_records_rest/errors.py:196
msgid "Could not load data."
msgstr "데이터를 불러올 수 없습니다."

#: invenio_records_rest/errors.py:208
msgid "Could not patch JSON."
msgstr "JSON을 패치할 수 없습니다."

#: invenio_records_rest/errors.py:221
#, python-format
msgid "Missing %(ctx_field)s context."
msgstr "%(ctx_field)s 컨텍스트가 없습니다."

#: invenio_records_rest/errors.py:236
#, python-format
msgid "No completions requested.%(options)s"
msgstr "요청된 자동완성이 없습니다.%(options)s"

#: invenio_records_rest/errors.py:251
#, python-format
msgid "Validation error: %(error)s."
msgstr "검증 오류: %(error)s."

