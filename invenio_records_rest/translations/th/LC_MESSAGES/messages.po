#: invenio_records_rest/errors.py:59
msgid "Invalid query syntax."
msgstr "ไวยากรณ์คำค้นหาไม่ถูกต้อง"

#: invenio_records_rest/errors.py:75
#, python-format
msgid "Style %(style)s could not be found."
